# Copy this file to .env and fill in the values for your machine.
# .env is local configuration. Do not commit it.
# On Streamlit Community Cloud or Render, put the same names in the host's
# secret store. Do not upload this file. Leave APP_API_KEY empty on a public
# estimator so visitors can open the catalog. Set an OpenAI usage cap, because
# a public photo upload spends OPENAI_API_KEY.

# Local SQLite file. No database server, username, or password is required.
# A relative path is stored next to the application.
SQLITE_PATH=rag.sqlite

# Optional shared secret. When set, /upload, /query, /documents, /catalog,
# /estimate, and /analyze-photo require header X-API-Key or Authorization: Bearer <key>.
# /health stays open.
APP_API_KEY=

# Local embedding model. EMBEDDING_DIM must match the model.
# all-MiniLM-L6-v2 produces 384-dimensional vectors.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# Chunking and retrieval.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_SIMILARITY=0.2
MAX_CHUNKS=2000

# OpenAI-compatible chat completions. Leave the key empty to return
# retrieved passages without calling a language model.
# Property photos accept LLM_API_KEY, OPENAI_API_KEY, or GROQ_API_KEY.
# A Groq key always uses https://api.groq.com/openai/v1.
# Set LLM_MODEL to qwen/qwen3.8-27b for Groq photos.
# llama-3.2-90b-vision-preview was retired and is replaced with that model.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Property photos use the chat endpoint. The model must accept images.
# VISION_MODEL overrides LLM_MODEL for /analyze-photo.
# A Groq key uses qwen/qwen3.8-27b unless VISION_MODEL names another current vision model.
VISION_MODEL=

# Patio, gate, stair, and railing mockups edit the uploaded photo on OpenAI.
# IMAGE_MODEL defaults to gpt-image-2.5-sunburst. A Groq key cannot draw mockups.
IMAGE_MODEL=

# Chat messages allowed per minute from one address. After that, the next
# message waits 15 seconds. Sample-photo questions use the same limit.
CHAT_RATE_LIMIT_PER_MINUTE=30

# Shop contact. The chat uses the phone and email when it tells a customer
# how to schedule a technician. Lead texts and emails go to this phone and
# email. Put the same names in the Streamlit secret box. Do not put the real
# values in showcase files.
SHOP_OWNER_NAME=Shop owner name
SHOP_PHONE=000-000-0000
SHOP_EMAIL=shop@example.com
# Leave empty to follow the English / Farsi selector. Set en or fa to force it.
SHOP_NOTIFY_LANGUAGE=

# Text message. When all three Twilio values are set, the shop summary is
# texted to SHOP_PHONE. Leave them blank to use email-to-SMS instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Carrier email for SHOP_PHONE. Used only when Twilio is not set.
# T-Mobile: 0000000000@tmomail.net
# Verizon: 0000000000@vtext.com
# AT&T: 0000000000@txt.att.net
# Also requires the SMTP settings below. The full summary still goes to SHOP_EMAIL.
SHOP_SMS_EMAIL=

# Email for the full shop summary, and for the short email-to-SMS text.
# Leave SMTP_HOST blank to skip both.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Leave blank to run the estimator inside Streamlit. Set a full URL only
# when this page should call a separate Flask API.
API_BASE_URL=

# Passcode for the shop inbox. Customers do not see leads until this matches.
SHOP_PASSCODE=

# HTTP service. run_phone.ps1 sets HOST=0.0.0.0 for that session only.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
